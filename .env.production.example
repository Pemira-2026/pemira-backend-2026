# ==============================================================================
# PEMIRA 2026 - BACKEND PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy to .env.production and fill EVERY placeholder marked CHANGEME.
# Never commit the filled file. Generate secrets with:
#   openssl rand -base64 48
# The backend refuses to start in production if secrets are empty, too short,
# identical where dual-control is required, or match known insecure defaults.
# ==============================================================================

# --- Server -------------------------------------------------------------------
SERVER_PORT=8080
SERVER_ENV=production
# Comma-separated CIDRs/IPs of your reverse proxy / load balancer only.
# Do NOT use 0.0.0.0/0 or "*".
TRUSTED_PROXIES=127.0.0.1,::1

# --- Database (PostgreSQL 16) -------------------------------------------------
# Prefer a private network + TLS. Example:
# DATABASE_URL=postgresql://pemira_app:CHANGEME@db.internal:5432/pemira_db?sslmode=verify-full
DATABASE_URL=postgresql://pemira_app:CHANGEME@db.internal:5432/pemira_db?sslmode=require
DB_DRIVER=postgres
DB_HOST=db.internal
DB_PORT=5432
DB_USER=pemira_app
DB_PASSWORD=CHANGEME
DB_NAME=pemira_db
DB_SSLMODE=require

DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=30
DB_CONN_MAX_LIFETIME=5m

# Production: apply SQL migrations BEFORE boot (deploy/scripts/migrate.sh),
# then leave auto-migrate off. Seeding is always forced off in production.
DB_AUTO_MIGRATE=false
SEED_DEV_DATA=false

# --- Redis (required in production) ------------------------------------------
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME
REDIS_DB=0
REDIS_REQUIRED=true

# --- Application secrets (min 32 chars, unique, random) ----------------------
JWT_SECRET=CHANGEME_openssl_rand_base64_48
RECEIPT_SECRET_KEY=CHANGEME_openssl_rand_base64_48
# Min 16 chars. Changing this invalidates previously issued receipts.
RECEIPT_SALT=CHANGEME_openssl_rand_base64_24

# --- Google OAuth 2.0 (campus SSO) -------------------------------------------
GOOGLE_CLIENT_ID=CHANGEME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGEME
GOOGLE_REDIRECT_URL=https://api.pemira.example.ac.id/api/v1/auth/google/callback
CAMPUS_EMAIL_DOMAIN=stu.pnj.ac.id

# --- Cloudflare Turnstile -----------------------------------------------------
TURNSTILE_SECRET_KEY=CHANGEME
ENABLE_TURNSTILE_VERIFY=true
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT=5s

# --- Election dual-control quorum secrets ------------------------------------
# Must be different from each other, min 16 chars, stored in a secret manager,
# and split between KPU chair and Bawaslu coordinator. Never reuse JWT secrets.
KPU_MASTER_SECRET=CHANGEME_kpu_only_secret
BAWASLU_AUDIT_SECRET=CHANGEME_bawaslu_only_secret

# --- Frontend origins (CORS allow-list) --------------------------------------
VOTER_FRONTEND_URL=https://pemira.example.ac.id
ADMIN_FRONTEND_URL=https://admin.pemira.example.ac.id

# --- Operational hardening ----------------------------------------------------
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true
# Bearer token required to scrape /metrics. If empty, only expose /metrics on a
# private interface and scrape over the internal network.
METRICS_TOKEN=CHANGEME_metrics_scrape_token

# --- MCP operator server (stdio) ---------------------------------------------
# Production default is read-only. Only enable a flag after a signed change
# request from KPU + Bawaslu. Mock login MUST remain false in production.
MCP_OPERATOR_ROLE=readonly
MCP_ALLOW_VOTE_SUBMIT=false
MCP_ALLOW_TALLY=false
MCP_ALLOW_CONFIG_MUTATION=false
MCP_ALLOW_AUDIT_LOGS=false
MCP_ALLOW_LOOKUP_VOTER=false
MCP_ALLOW_MOCK_LOGIN=false

# --- Docker Compose-only variables -------------------------------------------
# These are read by deploy/docker-compose.production.yml, not by the Go app.
# Keep POSTGRES_PASSWORD identical to the password in DATABASE_URL.
POSTGRES_USER=pemira_app
POSTGRES_PASSWORD=CHANGEME_same_as_DATABASE_URL_password
POSTGRES_DB=pemira_db

TLS_CERT_PATH=/etc/pemira/tls/fullchain.pem
TLS_KEY_PATH=/etc/pemira/tls/privkey.pem
FRONTEND_DIST_PATH=/opt/pemira/artifacts/frontend-dist
ADMIN_DIST_PATH=/opt/pemira/artifacts/admin-dist
