# ==============================================================================
# PEMIRA 2026 - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SERVER_ENV=development # development | production

# Database Configuration (PostgreSQL / MySQL / Supabase)
# Opsi 1: Pakai Connection String / URI Supabase langsung:
# DATABASE_URL=postgresql://postgres.duhpgsybixyxlzscfyts:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Opsi 2: Parameter terpisah (jika DATABASE_URL kosong)
DB_DRIVER=postgres # postgres | mysql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pemira_db
DB_SSLMODE=disable

# Connection Pool Tuning
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=30
DB_CONN_MAX_LIFETIME=5m

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & Cryptography
JWT_SECRET=super-secret-jwt-signing-key-pemira-2026-minimum-32-chars
RECEIPT_SECRET_KEY=super-secret-hmac-sha256-receipt-key-pemira-2026-change-in-prod
RECEIPT_SALT=random-salt-salt-salt-2026

# Google OAuth 2.0 (SSO Mahasiswa)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
CAMPUS_EMAIL_DOMAIN=stu.pnj.ac.id # Domain yang diizinkan

# Cloudflare Turnstile (Bot Protection)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA # Dev dummy or real secret
ENABLE_TURNSTILE_VERIFY=false # set true in production

# Election Dual-Control Quorum Secret Keys (Tally Unlock)
KPU_MASTER_SECRET=kpu-master-secret-key-2026
BAWASLU_AUDIT_SECRET=bawaslu-audit-secret-key-2026

# Frontend Client URLs (CORS Whitelist)
VOTER_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174
