# ==============================================================================
# PEMIRA 2026 - BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SERVER_ENV=development # development | production | test

# Database Configuration (PostgreSQL / MySQL / SQLite)
# Opsi 1: Pakai Connection String / URI Supabase / Cloud SQL langsung:
# DATABASE_URL=postgresql://user:password@host:5432/pemira_db?sslmode=require
DATABASE_URL=

# Opsi 2: Parameter terpisah (jika DATABASE_URL kosong)
DB_DRIVER=postgres # postgres | mysql | sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pemira_db
DB_SSLMODE=disable

# Database Connection Pool Tuning
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=30
DB_CONN_MAX_LIFETIME=5m

# Database Migration & Seed Control
# Di development, DB_AUTO_MIGRATE=true dan SEED_DEV_DATA=true secara default.
# Di production, SEED_DEV_DATA mutlak non-aktif (false) demi integritas data pemilu.
DB_AUTO_MIGRATE=true
SEED_DEV_DATA=true

# Redis Configuration (Distributed Locking & OAuth State)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_REQUIRED=false # Set true di production (wajib aktif demi mencegah race condition voting)

# Security & Cryptography (WAJIB DIGANTI di production dengan minimal 32 karakter unik!)
# Di production, sistem MENOLAK start jika masih menggunakan default secret di bawah ini.
JWT_SECRET=super-secret-jwt-signing-key-pemira-2026-minimum-32-chars
RECEIPT_SECRET_KEY=super-secret-hmac-sha256-receipt-key-pemira-2026-change-in-prod
RECEIPT_SALT=random-salt-salt-salt-2026

# Google OAuth 2.0 (SSO Mahasiswa)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
CAMPUS_EMAIL_DOMAIN=stu.pnj.ac.id # Domain yang diizinkan

# Cloudflare Turnstile (Bot Protection)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA # Dev dummy or real secret
ENABLE_TURNSTILE_VERIFY=false # set true in production

# Election Dual-Control Quorum Secret Keys (Tally Unlock)
# Kunci KPU dan Bawaslu HARUS BERBEDA dan minimal 16 karakter di production.
KPU_MASTER_SECRET=kpu-master-secret-key-2026
BAWASLU_AUDIT_SECRET=bawaslu-audit-secret-key-2026

# Frontend Client URLs (CORS Whitelist)
VOTER_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# Reverse Proxy / Infrastructure
# Comma-separated IPs/CIDRs allowed to supply X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1

# Cloudflare Turnstile verification tuning (testable in dev)
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT=5s

# Operational hardening
RATE_LIMIT_ENABLED=true
METRICS_ENABLED=true
# Bearer token required to scrape /metrics. Set a long random value in production.
METRICS_TOKEN=

# MCP operator server (stdio). Production defaults: readonly, all flags false.
MCP_OPERATOR_ROLE=admin
MCP_ALLOW_VOTE_SUBMIT=false
MCP_ALLOW_TALLY=false
MCP_ALLOW_CONFIG_MUTATION=false
MCP_ALLOW_AUDIT_LOGS=false
MCP_ALLOW_LOOKUP_VOTER=false
MCP_ALLOW_MOCK_LOGIN=true
